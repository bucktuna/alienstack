WEBUI_NAME=Sentinel
WEBUI_URL=https://sentinel.example.com
CORS_ALLOW_ORIGIN=https://sentinel.example.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
WEBUI_AUTH=true
ENABLE_SIGNUP=false
# Environment is authoritative for this clean example, rather than stored config.
ENABLE_PERSISTENT_CONFIG=false
AIOHTTP_CLIENT_TIMEOUT=300
AIOHTTP_CLIENT_STREAM_IDLE_TIMEOUT=120
AIOHTTP_POOL_CONNECTIONS=8
AIOHTTP_POOL_CONNECTIONS_PER_HOST=2
ENABLE_AUTOMATIONS=false
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_AUTOCOMPLETE_GENERATION=false
